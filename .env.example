# ═══════════════════════════════════════════════════════════
# 环境变量参考（示例）
# ═══════════════════════════════════════════════════════════
#
# ⚠️ 重要：妹抖酱**不会自动加载 .env 文件**。
#    本文件仅作为「可用环境变量清单」参考，不会被程序读取。
#
# 密钥实际生效的两条路径（优先级从高到低）：
#   1. 系统环境变量（在系统里设置，或当前 shell 中 export）
#   2. config/apikey.local —— 推荐方式，每行 `KEY = "VALUE"`
#      启动时自动读取并注入环境变量（不覆盖已存在的同名变量）
#
# 想用 .env 的话，需要你自己在启动前把它导出为环境变量，例如：
#   set -a; source .env; set +a
#
# 最省事的做法：不用本文件，直接在「设置 → 模型」界面填密钥，
# 程序会自动写入 config/apikey.local。

# ── 对话模型密钥 ──
# 对应 config/model.toml 里的 api_key = "${MEIDO__KEY}"
MEIDO__KEY=

# ── 兼容旧版的兜底变量（core/brain.py 与 core/config/loader.py 会读取） ──
DEEPSEEK_API_KEY=
# 用于区分不同用户的会话标识；不填则按主机名生成
DEEPSEEK_USER_ID=

# ── 本地服务商说明（无需真实密钥） ──
# Ollama    默认地址 http://localhost:11434/v1   api_key 填 "ollama" 即可
# LM Studio 默认地址 http://localhost:1234/v1
