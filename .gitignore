# ═══════════════════════════════════════════════════════════
# 凭据：绝不入库
# 注意：本文件不支持行内注释（# 必须独占一行），否则整行会被当成 pattern
# ═══════════════════════════════════════════════════════════

# 含 OneBot token，且实测零代码引用
config/adapters.toml

# 含 OneBot token（生效中）
qq/config.toml

# 含 SearXNG secret_key
searxng/settings.yml

# 含明文 API Key（旧版对话导出）
WhaleGirl_v2 lib/V1对话记录.txt

config/apikey.local
*.local
.env
.env.*
!.env.example

# ═══════════════════════════════════════════════════════════
# Python
# ═══════════════════════════════════════════════════════════
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# ═══════════════════════════════════════════════════════════
# 运行时数据（含私人对话、长期记忆、向量库 → 不入库）
# ═══════════════════════════════════════════════════════════
/workspaces/
/conversations/
/data/
# 根目录的对话记忆快照：含私人对话摘要全文，绝不入库
/conversation_memory.json
plugins/*/chroma_db/
plugins/*/cache_db/
plugins/*/bm25_data/
vector_db/
*.sqlite3
*.log
*.tmp

