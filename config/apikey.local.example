# ═══════════════════════════════════════════════════════════
# 本地密钥文件（示例模板）
# ═══════════════════════════════════════════════════════════
#
# 用法：复制为同目录下的 apikey.local（去掉 .example 后缀）
#
#     cp config/apikey.local.example config/apikey.local
#
# 格式：每行 `KEY = "VALUE"`
#   - 空行、以 # 开头的行会被忽略
#   - 不含 `=` 的行会被跳过（所以不要写成裸 key 一行）
#   - 启动时读入并注入环境变量，**不覆盖已存在的同名环境变量**
#   - 该文件已写入 .gitignore，明文不会进版本库
#
# 通常无需手工维护：在「设置 → 模型」界面填写密钥时，
# 程序会自动把真值写入本文件（见 core/config/loader.py: save_secret）。

# ── 对话模型密钥 ──
# 对应 config/model.toml 里的 api_key = "${MEIDO__KEY}"
# （站点名为纯中文时会被清洗成空串，故变量名是双下划线 MEIDO__KEY）
MEIDO__KEY = "sk-在此填入你的-DeepSeek-API-Key"
